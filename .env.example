# Rerun environment (SPEC §9). Copy to .env.local and fill in what you need. Never commit values.

# live (default) or demo. Demo mode needs no credentials.
RERUN_MODE=
# 1 to replay demo agents and the verifier at simulated speed (`npm run demo` sets it).
# RERUN_DEMO_PACE=

# Anthropic API key for agents/summaries (live). RERUN_ANTHROPIC_API_KEY, if set, takes precedence.
ANTHROPIC_API_KEY=
# RERUN_ANTHROPIC_API_KEY=

# TypeSafe System One (Jev) decision API key (live). Without it the LLM decision provider is used.
JEV_API_KEY=

# HCP Terraform token + org (live). Passed to the terraform-mcp container only; the app never calls HCP Terraform with it.
TFE_TOKEN=
TFE_ORG=

# Workspace Rerun watches (default rerun-fixtures). The MCP client refuses any other workspace.
RERUN_WORKSPACE=

# Fine-grained GitHub PAT scoped to the fixtures repo (live), and that repo (default tayden-b/rerun-fixtures).
GITHUB_TOKEN=
RERUN_FIXTURES_REPO=

# HMAC secret for HCP Terraform notifications; enables POST /api/webhook/tfc when set.
TFC_WEBHOOK_SECRET=

# Terraform MCP server endpoint (default http://127.0.0.1:8080/mcp; demo mode's mock uses :8081).
TERRAFORM_MCP_URL=

# Poll interval in seconds for list_runs (default 30; 0 disables polling).
RERUN_POLL_SECONDS=

# Model ids (defaults claude-sonnet-5-5 / claude-haiku-5-5).
RERUN_MODEL_AGENT=
RERUN_MODEL_FAST=

# Optional Langfuse tracing exporter.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# libSQL database URL (default file:data/rerun.db).
DATABASE_URL=
