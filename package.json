{
  "name": "rerun",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.mts",
    "test:e2e": "node scripts/not-implemented.mjs test:e2e W1-E",
    "eval": "node scripts/not-implemented.mjs eval W1-F",
    "eval:readme": "node scripts/not-implemented.mjs eval:readme W1-F",
    "record": "node scripts/not-implemented.mjs record W1-A",
    "mock-mcp": "tsx scripts/mock-mcp.ts",
    "demo": "tsx scripts/demo.ts",
    "db:migrate": "drizzle-kit generate && tsx scripts/db-migrate.ts",
    "prompts": "tsx src/agents/prompts/build.ts && prettier --write src/agents/prompts/generated.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.143",
    "@libsql/client": "0.18.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@next/env": "16.4.6",
    "ai": "6.0.333",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.23.0",
    "tw-animate-css": "1.4.0",
    "workflow": "5.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
